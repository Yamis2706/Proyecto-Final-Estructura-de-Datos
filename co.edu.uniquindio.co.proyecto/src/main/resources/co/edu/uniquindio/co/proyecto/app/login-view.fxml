<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.co.proyecto.app.LoginController">
  <center>
    <VBox spacing="12" alignment="CENTER" styleClass="card">
      <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
      </padding>
      <Label text="SyncUp" styleClass="title" />
      <TextField fx:id="usernameField" promptText="Usuario" />
      <PasswordField fx:id="passwordField" promptText="Contraseña" />
      <ChoiceBox fx:id="roleChoice" />
      <HBox spacing="10">
        <Button text="Registrar" onAction="#onRegister" />
        <Button fx:id="loginButton" text="Ingresar" onAction="#onLogin" />
      </HBox>
      <Label fx:id="messageLabel" textFill="red" />
    </VBox>
  </center>
</BorderPane>


