<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.co.proyecto.app.LoginController"
            prefWidth="420" prefHeight="520"
            style="-fx-background-color: linear-gradient(to bottom right, #4A00E0, #8E2DE2);">

  <VBox spacing="18" alignment="CENTER"
        AnchorPane.topAnchor="40" AnchorPane.leftAnchor="40"
        AnchorPane.rightAnchor="40" AnchorPane.bottomAnchor="40"
        style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">

    <Label text="¡Bienvenida a SyncUp!" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4A00E0;"/>

    <TextField fx:id="usernameField" promptText="Nombre de usuario"
               style="-fx-background-radius: 10; -fx-padding: 10;"/>

    <PasswordField fx:id="passwordField" promptText="Contraseña"
                   style="-fx-background-radius: 10; -fx-padding: 10;"/>

    <!-- AQUÍ estaba el error: Este ChoiceBox NO existía -->
    <ChoiceBox fx:id="roleChoice" prefWidth="200"
               style="-fx-background-radius: 10;"/>

    <Label fx:id="messageLabel" textFill="red" />

    <Button fx:id="loginButton" text="Ingresar" onAction="#onLogin"
            style="-fx-background-color: #8E2DE2; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 14;" />

    <Button fx:id="registerButton" text="Crear cuenta" onAction="#onRegister"
            style="-fx-background-color: transparent; -fx-text-fill: #4A00E0;
                       -fx-font-size: 13; -fx-underline: true;" />

  </VBox>
</AnchorPane>


