<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="800" prefHeight="520"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.co.proyecto.app.AdminController">

  <!-- BOTÓN SALIR -->
  <Button fx:id="btnLogout"
          text="Salir"
          layoutX="20"
          layoutY="20"
          onAction="#onLogout"
          style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;"/>

  <VBox spacing="20"
        layoutX="30"
        layoutY="70"
        prefWidth="740"
        prefHeight="420">

    <Label text="Panel de Administración"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- TABLA DE CANCIONES -->
    <TableView fx:id="songTable" prefHeight="350">

      <columns>

        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
        <TableColumn fx:id="colTitulo" text="Título" prefWidth="180"/>
        <TableColumn fx:id="colArtista" text="Artista" prefWidth="150"/>
        <TableColumn fx:id="colGenero" text="Género" prefWidth="120"/>
        <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
        <TableColumn fx:id="colDuracion" text="Duración (seg)" prefWidth="120"/>

      </columns>

    </TableView>

    <!-- BOTONES DE ACCIÓN -->
    <HBox spacing="15" alignment="CENTER">

      <Button text="Registrar canción"
              fx:id="btnRegisterSong"
              onAction="#onRegisterSong"
              style="-fx-background-color: #5cb85c; -fx-text-fill: white; -fx-font-weight: bold;"
              prefWidth="160"/>

      <Button text="Editar canción"
              fx:id="btnEditSong"
              onAction="#onEditSong"
              style="-fx-background-color: #0275d8; -fx-text-fill: white; -fx-font-weight: bold;"
              prefWidth="160"/>

      <Button text="Eliminar canción"
              fx:id="btnDeleteSong"
              onAction="#onDeleteSong"
              style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;"
              prefWidth="160"/>

    </HBox>

  </VBox>

</AnchorPane>
