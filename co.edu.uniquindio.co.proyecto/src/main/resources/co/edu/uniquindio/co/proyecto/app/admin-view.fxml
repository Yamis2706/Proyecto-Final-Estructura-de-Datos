<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.co.proyecto.app.AdminController"
            prefWidth="900" prefHeight="640"
            style="-fx-background-color: #F7F4FF;">

  <!-- PANEL SUPERIOR -->
  <top>
    <HBox spacing="20" alignment="CENTER_LEFT"
          style="-fx-background-color: #6A57A5; -fx-padding: 18;">
      <Label text="Panel Administrador - SyncUp"
             style="-fx-font-size: 26px; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
  </top>

  <!-- PANEL IZQUIERDO -->
  <left>
    <VBox spacing="18" alignment="TOP_CENTER"
          prefWidth="240"
          style="-fx-background-color: #2E2A62; -fx-padding: 20;">

      <Button text="➕ Registrar Canción"
              onAction="#onRegisterSong"
              style="-fx-background-radius: 12; -fx-background-color: #8E7CC3; -fx-text-fill: white;"
              prefWidth="200"/>

      <Button text="✏ Editar Canción"
              onAction="#onEditSong"
              style="-fx-background-radius: 12; -fx-background-color: #8E7CC3; -fx-text-fill: white;"
              prefWidth="200"/>

      <Button text="❌ Eliminar Canción"
              onAction="#onDeleteSong"
              style="-fx-background-radius: 12; -fx-background-color: #8E7CC3; -fx-text-fill: white;"
              prefWidth="200"/>

      <Button text="🚪 Salir"
              onAction="#onLogout"
              style="-fx-background-radius: 12; -fx-background-color: #B28BFF; -fx-text-fill: white;"
              prefWidth="200"/>

    </VBox>
  </left>

  <!-- PANEL CENTRAL -->
  <center>
    <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

      <TableView fx:id="songTable" prefHeight="500" prefWidth="650">
        <columns>
          <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
          <TableColumn fx:id="colTitulo" text="Título" prefWidth="160"/>
          <TableColumn fx:id="colArtista" text="Artista" prefWidth="160"/>
          <TableColumn fx:id="colGenero" text="Género" prefWidth="120"/>
          <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
          <TableColumn fx:id="colDuracion" text="Duración (s)" prefWidth="120"/>
        </columns>
      </TableView>

    </VBox>
  </center>

</BorderPane>
